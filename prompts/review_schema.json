{
  "type": "object",
  "additionalProperties": false,
  "required": ["sentiment", "aspects", "language", "status", "error"],
  "properties": {
    "sentiment": {"type": ["string", "null"], "enum": ["positive", "mixed", "negative", null]},
    "aspects": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["aspect", "polarity"],
        "properties": {
          "aspect": {"type": "string", "enum": ["location", "cleanliness", "host", "value", "amenities", "noise", "safety"]},
          "polarity": {"type": "string", "enum": ["positive", "mixed", "negative"]}
        }
      }
    },
    "language": {"type": "string", "pattern": "^([a-z]{2,3}|unknown)$"},
    "status": {"type": "string", "enum": ["ok", "needs_review"]},
    "error": {"type": ["string", "null"]}
  }
}
